        <mxCell id="ben1" value="&lt;b&gt;&#128737; Data Governance&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size:9px;&quot;&gt;Catch untracked apps within 24h&lt;br&gt;Compliance audit trail (SOC 2, GDPR)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#c8e6c9;strokeColor=#2e7d32;fontSize=10;shadow=1;" vertex="1" parent="1">
