# Cribl credentials — copy this to .env.prod (or any name) and fill in.
# Usage: python find_default_appids.py --config config.json
#
# The script does NOT override variables already set in the environment,
# so you can still use env vars to override individual values.
#
# IMPORTANT: chmod 600 this file after filling in credentials.

# Required — Cribl API base URL
CRIBL_URL=https://main-myorg.cribl.cloud

# Option 1: Cribl Cloud OAuth2 (recommended for prod)
CRIBL_CLIENT_ID=
CRIBL_CLIENT_SECRET=

# Option 2: Self-managed leader login
# CRIBL_USERNAME=
# CRIBL_PASSWORD=

# Option 3: Pre-existing bearer token
# CRIBL_TOKEN=

# Optional — override auto-detection of default output
# CRIBL_DEFAULT_OUTPUT_ID=azure_blob:foo-company-default

# Optional — Elasticsearch (alternative to config.json elasticsearch section)
# ES_URL=https://elk.internal:9200
# ES_INDEX=cribl-untracked-appids
# ES_API_KEY=
# ES_USERNAME=
# ES_PASSWORD=
